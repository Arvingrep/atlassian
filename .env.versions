# Upgrade these two values in a branch/PR. CI verifies that the official image
# tags exist and that the migration compose file still renders correctly.
JIRA_VERSION=9.6.0
CONFLUENCE_VERSION=7.19.7
ATLASSIAN_JAVA_TAG=jdk11
# Works natively on x86_64 Linux; Apple Silicon uses amd64 emulation because
# the legacy postgres:9.2 image has no ARM64 variant.
ATLASSIAN_PLATFORM=linux/amd64
