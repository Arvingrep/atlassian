# Project
COMPOSE_PROJECT_NAME=atlassian
TZ=Asia/Shanghai
ATLASSIAN_PLATFORM=linux/amd64
ATLASSIAN_JAVA_TAG=jdk11

# Images
NGINX_IMAGE=nginx:1.25
POSTGRES_IMAGE=postgres:9.2
JIRA_VERSION=9.6.0
CONFLUENCE_VERSION=7.19.7
JIRA_BASE_IMAGE=atlassian/jira-software:9.6.0-jdk11
CONFLUENCE_BASE_IMAGE=atlassian/confluence-server:7.19.7-jdk11
JIRA_GHCR_IMAGE=ghcr.io/arvingrep/atlassian-jira:9.6.0-example-agent
CONFLUENCE_GHCR_IMAGE=ghcr.io/arvingrep/atlassian-confluence:7.19.7-example-agent
JIRA_LOCAL_IMAGE=local/atlassian-jira:9.6.0
CONFLUENCE_LOCAL_IMAGE=local/atlassian-confluence:7.19.7

# PostgreSQL
POSTGRES_USER=atlassian
POSTGRES_PASSWORD=atlassian-migration-only
POSTGRES_CONTAINER=atlassian-pg92
POSTGRES_VOLUME=atlassian_pg92_data
POSTGRES_PORT=15432
POSTGRES_MAX_CONNECTIONS=200
JIRA_DB=jira
CONFLUENCE_DB=confluence

# Jira
JIRA_CONTAINER=jira-9.6.0
JIRA_DOMAIN=alpha-jira.sl-devops.com
JIRA_PORT=8080
JIRA_HOME_VOLUME=atlassian_jira_home
JIRA_XMS=2g
JIRA_XMX=6g

# Confluence
CONFLUENCE_CONTAINER=confluence-7.19.7
CONFLUENCE_DOMAIN=confsys.sl-devops.com
CONFLUENCE_PORT=8090
CONFLUENCE_SYNCHRONY_PORT=8091
CONFLUENCE_HOME_VOLUME=atlassian_confluence_home
CONFLUENCE_XMS=2g
CONFLUENCE_XMX=6g

# Nginx
NGINX_CONTAINER=atlassian-nginx
HTTP_PORT=80
HTTPS_PORT=443

# TLS (wildcard *.sl-devops.com, valid until 2026-12-11)
NGINX_TLS_CERT=/Users/arvin/.hermes/cache/scratch/atlassian/nginx/ssl/full_chain_rsa.crt
NGINX_TLS_KEY=/Users/arvin/.hermes/cache/scratch/atlassian/nginx/ssl/sl-devops.com.key

# Public scheme advertised to Jira and Confluence
ATL_PROXY_PORT=443
ATL_TOMCAT_SCHEME=https
